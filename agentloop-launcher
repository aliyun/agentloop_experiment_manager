#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [[ ! -f "$SCRIPT_DIR/backend/app/static/index.html" ]]; then
  npm ci --prefix "$SCRIPT_DIR/frontend"
  npm run build --prefix "$SCRIPT_DIR/frontend"
fi

exec uv run --project "$SCRIPT_DIR/backend" agentloop-launcher "$@"

AGENTLOOP_LAUNCHER_ENVIRONMENT=development
AGENTLOOP_LAUNCHER_HOST=127.0.0.1
AGENTLOOP_LAUNCHER_PORT=8090
# Keep false by default. Non-loopback also requires production mode and an external master key.
AGENTLOOP_LAUNCHER_ALLOW_REMOTE_ACCESS=false
AGENTLOOP_LAUNCHER_DATA_DIR=./var
# disabled is the safe default. fake is for local UI development only.
AGENTLOOP_LAUNCHER_GATEWAY_MODE=disabled
AGENTLOOP_LAUNCHER_SCHEDULER_ENABLED=false
AGENTLOOP_LAUNCHER_TRACE_LOOKUP_TIMEOUT_SECONDS=180
# Formal deployments inject this externally. The start-agentloop-remote helper instead uses
# the explicit local master.key mode and does not require this variable.
# Generate outside the process: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AGENTLOOP_LAUNCHER_MASTER_KEY=
AGENTLOOP_LAUNCHER_CONSOLE_BASE_URL=
